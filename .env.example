# Study Hub environment variables (spec section 12).
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.

# Supabase — public values, safe for the browser.
# Local dev defaults (refresh after `supabase start`; see `supabase status`):
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Service-role key. Server-side ONLY — never sent to the browser, never logged.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# 32-byte base64 key for encrypting AI API keys at rest (AES-256-GCM, M7).
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=replace-me

# Hashes for machine tokens (M6/M8). Store the raw tokens only on the worker PC.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_TOKEN_HASH=replace-me
BACKUP_TOKEN_HASH=replace-me

# Secret that signs the student join-code cookie (M4), 32+ bytes.
JOIN_COOKIE_SECRET=replace-me

# Public site address, used in links and the admin's Copy-message text (M1).
APP_URL=http://127.0.0.1:3000

# Seed script: the first admin account's email (local/CI seed only).
SEED_ADMIN_EMAIL=admin@studyhub.local
